{
  "name": "@shesha-io/core",
  "version": "0.1.0",
  "description": "Framework-agnostic core for the Shesha framework — plugin infrastructure, HTTP client interface, and application lifecycle management",
  "license": "GPL-3.0",
  "homepage": "https://www.shesha.io/",
  "repository": {
    "type": "git",
    "url": "https://github.com/shesha-io/shesha-framework"
  },
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./http": {
      "import": "./dist/http/index.esm.js",
      "require": "./dist/http/index.js",
      "types": "./dist/http/index.d.ts"
    },
    "./plugins": {
      "import": "./dist/plugins/index.esm.js",
      "require": "./dist/plugins/index.js",
      "types": "./dist/plugins/index.d.ts"
    }
  },
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/.bin/jest"
  },
  "files": [
    "dist",
    "src"
  ],
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
